// =============================================================================
// Jenkinsfile - The Tip Top (Furious Ducks CI/CD)
//
// Full CI/CD pipeline for the The Tip Top application.
//
// Pipeline flow:
//   develop branch  -> Lint, Test, SonarQube, Docker Build/Push, Deploy DEV
//   main branch     -> All of the above + SAST, Gitleaks, E2E, K6, Deploy PREPROD
//   semver tag      -> All of the above + Approval + Blue/Green Deploy PROD
// =============================================================================

@Library('furious-ducks-shared-library') _

def projectName = 'thetiptop'

ciPipeline(
    projectName   : projectName,
    stack         : 'node',
    sonarProject  : projectName,

    // Deployment toggles
    deployDev     : true,
    deployPreprod : true,
    deployProd    : true,

    // Test toggles
    // Load testing is NOT here: it runs as its own scheduled job, see
    // Jenkinsfile.k6.thetiptop.
    runE2E        : true,
    runZap        : true,   // OWASP ZAP baseline against PREPROD

    // Post-deploy stability watch on PREPROD, with automatic rollback
    preprodMonitorMinutes: 5,

    // Comité de pilotage (cf. cahier des charges). PREPROD notifies the people
    // who run the functional acceptance; PROD adds both sponsors.
    notifyRecipients: [
        preprod: 'alexandre.petit@thetiptop.fr,' +
                 'nathalie.dubois@thetiptop.fr,' +
                 'harenaandriamananjaramandimby@furiousducks.fr,' +
                 'baptistetabarlabonne@furiousducks.com',
        prod   : 'eric.bourdon@thetiptop.fr,' +
                 'nathalie.dubois@thetiptop.fr,' +
                 'alexandre.petit@thetiptop.fr,' +
                 'guido.brasletti@furiousducks.com,' +
                 'harenaandriamananjaramandimby@furiousducks.fr,' +
                 'baptistetabarlabonne@furiousducks.com'
    ],

    // Domains (one per environment)
    // DEV/PREPROD -> wk-* (workflow platform domain)
    // PROD -> dsp5-* (site internet domain, required for the delivered client site)
    devDomain     : "${projectName}-dev.wk-archi-o24a-4-5-g1.fr",
    preprodDomain : "${projectName}-preprod.wk-archi-o24a-4-5-g1.fr",
    prodDomain    : "${projectName}.dsp5-archi-o24a-4-5-g1.fr",

    // Application port
    appPort       : 3000,

    // Path to the Dockerfile (monorepo layout: app lives under webapp/)
    dockerfile    : 'webapp/Dockerfile',

    // Backend API (NestJS), deployed alongside the frontend.
    // Wired for DEV, PREPROD and PROD (PROD uses its own dedicated database
    // and JWT secrets, and deploys Blue/Green like the frontend).
    apiDockerfile  : 'api/Dockerfile',
    apiPort        : 3001,
    apiHealthPath  : '/api/v1/health',
    dbCredentialsId: 'thetiptop-db-credentials',   // Jenkins "username/password" cred

    // API domains (one per environment)
    devApiDomain    : "${projectName}-api-dev.wk-archi-o24a-4-5-g1.fr",
    preprodApiDomain: "${projectName}-api-preprod.wk-archi-o24a-4-5-g1.fr",
    // PROD API stays on the wk zone: dsp5 only hosts the frontend and has no
    // wildcard certificate, while wk has one.
    prodApiDomain   : "${projectName}-api.wk-archi-o24a-4-5-g1.fr",

    // Environment-independent API variables only. FRONTEND_URL and CORS_ORIGINS
    // are derived by the shared library from the target environment's frontend
    // domain - hard-coding them here pinned PREPROD to the DEV domain.
    apiEnv         : [
        API_PREFIX: 'api'
    ],
    apiSecretEnv   : [
        [envVar: 'JWT_SECRET', credentialId: 'thetiptop-jwt-secret'],
        [envVar: 'JWT_REFRESH_SECRET', credentialId: 'thetiptop-jwt-refresh-secret']
    ],

    // The CST (2.9) requires a distinct credential set per environment. The pilot
    // project deliberately runs DEV and PREPROD on the single shared set above:
    // splitting them triples the number of Jenkins credentials to create, store
    // and rotate for no benefit at this scale. To split them later, create the
    // PREPROD credentials in Jenkins and uncomment:
    //
    // dbCredentialsByEnv: [
    //     preprod: 'thetiptop-db-credentials-preprod'
    // ],
    // apiSecretEnvByEnv : [
    //     preprod: [
    //         [envVar: 'JWT_SECRET', credentialId: 'thetiptop-jwt-secret-preprod'],
    //         [envVar: 'JWT_REFRESH_SECRET', credentialId: 'thetiptop-jwt-refresh-secret-preprod']
    //     ]
    // ]

    // PROD always uses its own dedicated credentials - never falls back to the
    // shared DEV/PREPROD set above, to keep a compromised DEV/PREPROD secret
    // from ever granting access to the PROD database or signing PROD JWTs.
    dbCredentialsByEnv: [
        prod: 'thetiptop-db-credentials-prod'
    ],
    apiSecretEnvByEnv : [
        prod: [
            [envVar: 'JWT_SECRET', credentialId: 'thetiptop-jwt-secret-prod'],
            [envVar: 'JWT_REFRESH_SECRET', credentialId: 'thetiptop-jwt-refresh-secret-prod']
        ]
    ]
)
