// =============================================================================
// Template Jenkinsfile - Furious Ducks CI/CD
//
// This is a template Jenkinsfile for projects using the shared library.
// Copy this file to the root of your project repository and adjust the
// parameters below to match your project's configuration.
//
// Available stacks: 'node', 'php', 'python', 'ruby'
// =============================================================================
/* groovylint-disable CompileStatic, NoDef, UnusedVariable, VariableName, VariableTypeRequired */

@Library('furious-ducks-shared-library') _

def projectName = 'my-project'

ciPipeline(
    projectName   : projectName,
    stack         : 'node',         // 'node', 'php', 'python', 'ruby'
    sonarProject  : projectName,

    // Deployment toggles
    deployDev     : true,
    deployPreprod : true,
    deployProd    : true,

    // Test toggles
    runE2E        : true,
    runK6         : true,

    // Domains (one per environment)
    // DEV/PREPROD -> wk-* (workflow platform domain)
    // PROD -> dsp5-* (site internet domain, required for the delivered client site)
    devDomain     : "${projectName}-dev.wk-archi-o24a-4-5-g1.fr",
    preprodDomain : "${projectName}-preprod.wk-archi-o24a-4-5-g1.fr",
    prodDomain    : "${projectName}.dsp5-archi-o24a-4-5-g1.fr",

    // Application port exposed by the Docker container
    appPort       : 3000,

    // Path to the Dockerfile relative to the repo root (default: 'Dockerfile')
    dockerfile    : 'Dockerfile'
)
