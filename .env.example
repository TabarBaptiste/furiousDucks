# =============================================================================
# Furious Ducks - CI/CD Workflow - Variables d'environnement
# =============================================================================
# Copier ce fichier en .env et modifier les valeurs avant déploiement
# IMPORTANT : Ne jamais commiter le fichier .env dans le dépôt Git
# =============================================================================

# --- Domaine principal ---
DOMAIN=wk-archi-o24a-4-5-g1.fr
ACME_EMAIL=devops@wk-archi-o24a-4-5-g1.fr

# --- Traefik ---
# Générer avec : htpasswd -nB admin
# Format: user:hashed_password (escape $ as $$ in .env)
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$changeme

# --- GitLab CE ---
GITLAB_ROOT_PASSWORD=changeme
GITLAB_SHARED_RUNNERS_REGISTRATION_TOKEN=changeme_runner_token

# --- Jenkins ---
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=changeme

# --- SonarQube ---
SONARQUBE_DB_USER=sonarqube
SONARQUBE_DB_PASSWORD=changeme
SONARQUBE_DB_NAME=sonarqube

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# --- Harbor ---
HARBOR_ADMIN_PASSWORD=changeme
HARBOR_DB_PASSWORD=changeme_harbor_db_password
HARBOR_SECRET_KEY=changeme16chars!!

# --- MinIO (stockage S3 backups) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme

# --- Restic (backups) ---
RESTIC_PASSWORD=changeme

# --- SMTP (notifications) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@wk-archi-o24a-4-5-g1.fr
SMTP_PASSWORD=changeme

# --- Mattermost (alertes et notifications CI/CD) ---
# Créer un Incoming Webhook dans Mattermost : Intégrations > Webhooks entrants
MATTERMOST_WEBHOOK_URL=https://chat.wk-archi-o24a-4-5-g1.fr/hooks/CHANGE_ME
MATTERMOST_CHANNEL=devops-alerts

# --- Sécurité ---
# Clé de chiffrement pour les communications inter-services
INTERNAL_SECRET_KEY=changeme_internal_secret_key

# =============================================================================
# Fichiers de secrets (NON versionnés — voir .gitignore)
# =============================================================================
# Certains secrets ne transitent pas par ce .env mais par des fichiers montés
# dans les conteneurs. Créez-les à partir des modèles .example fournis :
#
#   alertmanager/secrets/smtp_password        <- mot de passe SMTP (Alertmanager)
#   alertmanager/secrets/mattermost_webhook   <- URL webhook Mattermost (Alertmanager)
#   prometheus/secrets/minio_token            <- bearer token MinIO (Prometheus)
#
# Exemple : cp alertmanager/secrets/smtp_password.example alertmanager/secrets/smtp_password
# puis éditez le fichier avec la vraie valeur.
